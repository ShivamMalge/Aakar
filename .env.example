# Aakar — copy to .env and fill. Never commit .env (rule 10).

# --- provider abstraction (spec §3) ---
AAKAR_PROVIDER_MODE=replay          # live | record | replay
AAKAR_MODEL=gemini-2.0-flash
AAKAR_VLM_MODEL=gemini-2.0-flash
AAKAR_EMBED_MODEL=text-embedding-004   # 768 dims, cosine (D-043) -- ONE-WAY DOOR
AAKAR_EMBED_DIMENSIONS=768        # changing this means re-embedding every corpus
AAKAR_API_KEY=
AAKAR_MAX_USD_PER_RUN=1.00        # global; protects the operator from the total bill

# --- model tiering (2B.8) ---
# Generation runs once per topic forever and amortises; QA runs per user per question and
# never stops. Only QA scales, which is why they are configured separately.
AAKAR_ANSWER_MODEL=               # defaults to AAKAR_MODEL rather than silently downgrading

# --- spend and abuse controls (2B.10, 2B.12) ---
AAKAR_RELEVANCE_FLOOR=0.35        # below it: "your chapter does not cover this" (2C.3)
AAKAR_CACHE_THRESHOLD=0.92        # conservative by ruling: a false hit is a wrong
                                  # answer, a low hit rate is only cost
AAKAR_MAX_QUESTIONS_PER_DAY=100   # per owner; protects everyone else from any one user
AAKAR_MAX_ACCOUNTS=25             # registration ceiling; beyond it, a waitlist

# --- ingest bounds (2A.3, D-037) ---
# Not spend limits: OCR runs ~25 s/page and costs nothing, so no budget guard fires.
AAKAR_MAX_CONCURRENT_OCR=2
AAKAR_MAX_QUEUE_DEPTH=50
AAKAR_MAX_JOB_SECONDS=1800        # per-job wall clock; bounds time, not pages (D-042)

# --- owner session (D-011) ---
AAKAR_AUTH_SECRET=dev-only-insecure-secret-change-me-before-any-real-use
AAKAR_OWNER_EMAIL=owner@example.com
AAKAR_OWNER_PASSWORD=                # hashed at first boot into users.password_hash

# --- infra ---
AAKAR_DB_PATH=data/aakar.db
QDRANT_URL=http://localhost:6333
