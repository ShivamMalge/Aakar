# Aakar — copy to .env and fill. Never commit .env (rule 10).
#
# THIS FILE IS READ AT STARTUP. `Settings.from_env()` loads `.env` from the repository root
# via python-dotenv, then reads the process environment. **Environment variables win**: a
# value already exported is never overwritten by this file, so a container or CI runner that
# sets AAKAR_MODEL keeps it even if a stray .env is present. Order, precisely:
#   1. anything already in the environment          (highest)
#   2. values from this file
#   3. the defaults compiled into aakar/config.py   (lowest)

# --- provider abstraction (spec §3) ---
AAKAR_PROVIDER_MODE=replay          # live | record | replay
AAKAR_MODEL=gemini-3.6-flash      # 2.0-flash was SHUT DOWN 2026-06-01 (D-045)
AAKAR_VLM_MODEL=gemini-3.6-flash  # multimodal; the VLM critic needs it
AAKAR_EMBED_MODEL=gemini-embedding-001  # 004 was SHUT DOWN 2026-01-14 (D-043 amended)
AAKAR_EMBED_DIMENSIONS=768        # ONE-WAY DOOR: changing it re-embeds every corpus.
                                  # NOT normalized by the provider below 3072 -- we L2 it.
AAKAR_API_KEY=
AAKAR_MAX_USD_PER_RUN=1.00        # global; protects the operator from the total bill

# --- model tiering (2B.8) ---
# Generation runs once per topic forever and amortises; QA runs per user per question and
# never stops. Only QA scales, which is why they are configured separately.
AAKAR_ANSWER_MODEL=               # defaults to AAKAR_MODEL rather than silently downgrading

# --- spend and abuse controls (2B.10, 2B.12) ---
AAKAR_RELEVANCE_FLOOR=0.75        # below it: "your chapter does not cover this" (2C.3).
                                  # CERTIFIED against gemini-embedding-001 @ 768d on
                                  # 2026-09-01 (D-058). A model change invalidates it.
AAKAR_CACHE_THRESHOLD=0.92        # conservative by ruling: a false hit is a wrong
                                  # answer, a low hit rate is only cost. On the golden set
                                  # it never fires — that set is adversarial, so the real
                                  # hit rate is UNMEASURED in either direction (D-059).
AAKAR_MAX_QUESTIONS_PER_DAY=100   # per owner; protects everyone else from any one user
AAKAR_MAX_ACCOUNTS=25             # registration ceiling; beyond it, a waitlist

# --- ingest bounds (2A.3, D-037) ---
# Not spend limits: OCR runs ~3-4 s/page (measured, 2C) and costs nothing, so no budget
# guard fires. The 25 s/page figure this line used to carry was wrong.
AAKAR_MAX_CONCURRENT_OCR=2
AAKAR_MAX_QUEUE_DEPTH=50
AAKAR_MAX_JOB_SECONDS=1800        # per-job wall clock; bounds time, not pages (D-042)

# --- owner session (D-011) ---
AAKAR_AUTH_SECRET=dev-only-insecure-secret-change-me-before-any-real-use
AAKAR_OWNER_EMAIL=owner@example.com
AAKAR_OWNER_PASSWORD=                # hashed at first boot into users.password_hash

# --- infra ---
AAKAR_DB_PATH=data/aakar.db
QDRANT_URL=http://localhost:6333
